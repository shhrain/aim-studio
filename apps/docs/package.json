{
  "name": "@aim/docs",
  "version": "0.1.0",
  "private": true,
  "description": "AIM Studio 文档站（Fumadocs）",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "typedoc && next build",
    "start": "next start --port 3002",
    "api": "typedoc",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rimraf .next .turbo .source"
  },
  "dependencies": {
    "@aim/template-core": "workspace:*",
    "@aim/template-preview": "workspace:*",
    "@aim/template-schema": "workspace:*",
    "@aim/utils": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@aim/eslint-config": "workspace:*",
    "@aim/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  }
}
