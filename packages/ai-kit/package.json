{
  "name": "@aim/ai-kit",
  "version": "0.1.0",
  "description": "面向 AI 编程 Agent 的 AIM 模板知识包：系统提示词、Cursor 规则、规范文档与示例模板（由 schema 自动生成）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./PROMPT.md": "./PROMPT.md"
  },
  "files": ["PROMPT.md", "examples", "src"],
  "scripts": {
    "generate": "tsx src/generate.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@aim/mock": "workspace:*",
    "@aim/template-core": "workspace:*",
    "@aim/template-schema": "workspace:*"
  },
  "devDependencies": {
    "@aim/eslint-config": "workspace:*",
    "@aim/tsconfig": "workspace:*",
    "@aim/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
