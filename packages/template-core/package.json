{
  "name": "@aim/template-core",
  "version": "0.0.0",
  "description": "5G 阅信模板内核：文档操作、插件注册、版式蓝图、校验与预检、AIM→RCS/RMS 三信融合转换、旧数据适配",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aim/template-schema": "workspace:*",
    "@aim/utils": "workspace:*"
  },
  "devDependencies": {
    "@aim/eslint-config": "workspace:*",
    "@aim/tsconfig": "workspace:*",
    "@aim/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
