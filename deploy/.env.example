# 部署脚本首次运行生成两项随机密钥，不要提交实际 .env。
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
COMPOSE_PROJECT_NAME=aim-studio
IMAGE_PREFIX=aim-studio
IMAGE_TAG=0.2.0
APP_ENV=development
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000
DOCS_PORT=3002
DOCS_PUBLIC_URL=http://localhost:3002
STORYBOOK_PORT=6006
STORYBOOK_PUBLIC_URL=
PROVIDER_MODE=disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AIM Studio <noreply@aim.local>
MAILPIT_PORT=8025
STORAGE_DRIVER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=52428800
WORKSPACE_STORAGE_BYTES=1073741824
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.28-alpine
NPM_REGISTRY=https://registry.npmjs.org

NEXT_DIST_DIR=.next
FFPROBE_PATH=ffprobe
