{
  "name": "@aim/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "端到端测试与视觉回归（Playwright）",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aim/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
