{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": [".env", "tooling/tsconfig/*.json"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_OUTPUT",
    "NEXT_PUBLIC_API_MOCK",
    "NEXT_PUBLIC_API_BASE",
    "NEXT_PUBLIC_MOBILE_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_EDITOR_URL",
    "NEXT_PUBLIC_STORYBOOK_URL",
    "NEXT_PUBLIC_WEB_URL",
    "API_INTERNAL_URL",
    "MOBILE_INTERNAL_URL",
    "PUBLIC_URL",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "PROVIDER_MODE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "MAIL_FROM",
    "STORAGE_DRIVER",
    "STORAGE_PATH",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "NEXT_DIST_DIR",
    "QA_WEB_PORT",
    "QA_MOBILE_PORT",
    "QA_DOCS_PORT",
    "QA_API_PORT",
    "FFPROBE_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.stories.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**", ".source/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
