{
  "name": "@aim/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "catalog:",
    "tsup": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "@types/pg": "catalog:",
    "@aim/tsconfig": "workspace:*",
    "@aim/eslint-config": "workspace:*",
    "@aim/vitest-config": "workspace:*"
  }
}
