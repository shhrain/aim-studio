{
  "name": "@aim/ui",
  "version": "0.0.0",
  "description": "AIM 企业级 UI 组件库（shadcn/ui + Radix + Tailwind v4），PC 与移动端共用设计 token",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./mobile": "./src/mobile/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mobile": {
        "types": "./dist/mobile/index.d.ts",
        "import": "./dist/mobile/index.js"
      },
      "./globals.css": "./src/styles/globals.css",
      "./lib/utils": {
        "types": "./dist/lib/utils.d.ts",
        "import": "./dist/lib/utils.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aim/tailwind-config": "workspace:*",
    "@aim/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "vaul": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aim/eslint-config": "workspace:*",
    "@aim/tsconfig": "workspace:*",
    "@aim/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
