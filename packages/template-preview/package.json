{
  "name": "@aim/template-preview",
  "version": "0.1.0",
  "description": "5G 阅信模板预览 SDK：React 渲染器、多厂商手机壳、AIM/RCS/RMS 三协议、移动端自适应、iframe 嵌入与 Web Component",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./embed": "./src/embed/host.ts",
    "./embed/receiver": "./src/embed/receiver.tsx",
    "./element": "./src/element/index.tsx",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./embed": { "types": "./dist/embed/host.d.ts", "import": "./dist/embed/host.js" },
      "./embed/receiver": { "types": "./dist/embed/receiver.d.ts", "import": "./dist/embed/receiver.js" },
      "./element": { "types": "./dist/element/index.d.ts", "import": "./dist/element/index.js" },
      "./styles.css": "./dist/styles.css"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aim/template-core": "workspace:*",
    "@aim/template-schema": "workspace:*",
    "@aim/utils": "workspace:*",
    "qrcode.react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aim/eslint-config": "workspace:*",
    "@aim/tsconfig": "workspace:*",
    "@aim/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
