{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tooling/tsconfig/*.json"],
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_API_MOCK", "NEXT_PUBLIC_MOBILE_URL", "NEXT_PUBLIC_DOCS_URL", "NEXT_PUBLIC_EDITOR_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.stories.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**", ".source/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
